{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zashiki",
  "mainBinaryName": "Zashiki",
  "version": "0.0.0",
  "identifier": "io.github.kounetsuman.zashiki",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "http://127.0.0.1:8790",
    "beforeDevCommand": "pnpm --filter @zashiki/shared build && cargo build --manifest-path ../../crates/zashiki-server/Cargo.toml && VITE_ZK_SERVER=http://127.0.0.1:8790 pnpm --filter @zashiki/client run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
