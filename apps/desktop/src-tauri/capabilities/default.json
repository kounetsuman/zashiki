{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "App commands for the frontend. Grants nothing by itself: at launch the shell grants these permissions to the exact origin the window is served from (src/ipc_capability.rs).",
  "windows": ["main"],
  "local": false,
  "permissions": [
    "core:default",
    "allow-open-devtools",
    "allow-open-in-browser",
    "allow-pick-and-read-files",
    "allow-report-memo-status",
    "allow-report-memo-saved",
    "allow-set-dashboard-origin",
    "allow-share-text",
    "allow-open-popout",
    "allow-focus-popout",
    "allow-close-popout",
    "allow-list-popouts",
    "allow-take-opened-files"
  ]
}
